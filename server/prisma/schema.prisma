generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  passwordHash               String?
  role                       UserRole                    @default(CITIZEN)
  emailVerified              Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  communityTaskRegistrations CommunityTaskRegistration[]
  otps                       Otp[]
  posts                      Post[]
  profile                    Profile?
  ledgerEntries              RewardLedger[]
  taskScore                  TaskScore[]
  taskSubmission             TaskSubmission[]
  badges                     UserBadge[]
  stats                      UserStats?
  tokens                     VerificationToken[]
  redemption                 Redemption?
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  username    String    @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  gender      String?
  country     String
  state       String
  city        String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id                 String    @id @default(cuid())
  userId             String    @unique
  totalContributions Int       @default(0)
  lastActivityAt     DateTime?
  xp                 Int       @default(0)
  level              Int       @default(1)
  actionsLast7Days   Int       @default(0)
  actionsLast30Days  Int       @default(0)
  engagementLevel    Float     @default(0.0)
  updatedAt          DateTime  @updatedAt
  currentStreak      Int       @default(0)
  globalRank         Int?
  longestStreak      Int       @default(0)
  nextMilestone      Float     @default(10.0)
  region             String?
  regionalRank       Int?
  rewardPoints       Int       @default(0)
  totalWeightRemoved Float     @default(0.0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  imageUrl    String
  rarity      BadgeRarity @default(COMMON)
  criteria    String
  createdAt   DateTime    @default(now())
  earnedBy    UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Post {
  id        String     @id @default(cuid())
  authorId  String
  content   String
  status    PostStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
}

model VerificationToken {
  id        String           @id @default(cuid())
  userId    String
  type      VerificationType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Otp {
  id            String           @id @default(cuid())
  userId        String
  code          String
  type          VerificationType
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  attempts      Int              @default(0)
  lastAttemptAt DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model payment_intents {
  id         String              @id @default(uuid())
  orderId    String              @unique
  userId     String
  campaignId String
  amount     Int
  currency   String              @default("INR")
  status     PaymentIntentStatus @default(CREATED)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([campaignId])
  @@index([userId])
}

model external_donations {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  orderId    String
  campaignId String
  amount     Int
  currency   String   @default("INR")
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([campaignId])
}

model campaigns {
  id          String   @id @default(uuid())
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Task {
  id             String          @id @default(cuid())
  type           TaskType
  title          String
  description    String
  baseScore      Int
  isActive       Boolean         @default(true)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  communityTask  CommunityTask?
  individualTask IndividualTask?
  taskScores     TaskScore[]
}

model IndividualTask {
  id               String               @id @default(cuid())
  taskId           String               @unique
  difficulty       Difficulty           @default(EASY)
  category         TaskCategory         @default(SUSTAINABILITY)
  verificationType TaskVerificationType
  isDaily          Boolean              @default(false)
  cooldownDays     Int?                  
  taskDuration     Int?                  // in minutes
  requirements     Json?
  educationalLink  String?
  factContent      String?
  task             Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submissions      TaskSubmission[]
}

model CommunityTask {
  id              String                      @id @default(cuid())
  taskId          String                      @unique
  maxParticipants Int?
  minParticipants Int?
  locationName    String?
  city            String?
  state           String?
  country         String?
  task            Task                        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  registrations   CommunityTaskRegistration[]
}

model CommunityTaskRegistration {
  id                  String        @id @default(cuid())
  taskId              String
  userId              String
  status              TaskStatus    @default(REGISTERED)
  completionConfirmed Boolean       @default(false)
  supervisorNote      String?
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  task                CommunityTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([status])
}

model TaskScore {
  id                 String               @id @default(cuid())
  userId             String
  taskId             String
  submissionId       String?              @unique
  status             TaskCompletionStatus @default(STARTED)
  baseScore          Int
  performanceScore   Int                  @default(0)
  verificationSource String?
  verifiedAt         DateTime?
  rewardedAt         DateTime?
  rewardLedger       RewardLedger?
  task               Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission          TaskSubmission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([status])
}

  
model TaskSubmission {
  id              String           @id @default(cuid())
  userId          String
  taskId          String
  status          SubmissionStatus @default(STARTED)
  startedAt       DateTime         @default(now())
  expiresAt       DateTime?
  evidenceUrls    String[]
  textResponse    String?
  mcqAnswer       String?
  submittedAt     DateTime         @default(now())
  verifiedAt      DateTime?
  rejectionReason String?
  task            IndividualTask   @relation(fields: [taskId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  taskScores TaskScore[]
}

model RewardLedger {
  id          String          @id @default(cuid())
  userId      String
  taskScoreId String?         @unique
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  reason      String?
  createdAt   DateTime        @default(now())
  taskScore   TaskScore?      @relation(fields: [taskScoreId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String
  credits     Int
  icon        String

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions Redemption[]
}

model Redemption {
  id         String   @id @default(cuid())
  userId     String   @unique
  rewardId   String   @unique
  rewardName String
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  users      User   @relation(fields: [userId], references: [id])

  rewards    Reward @relation(fields: [rewardId], references: [id])
}

model Area {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  createdAt DateTime @default(now())
  ngos      NGO[]
}

model NGO {
  id        String      @id @default(cuid())
  name      String
  status    NGOStatus   @default(PENDING)
  areaId    String
  createdAt DateTime    @default(now())
  logs      ActionLog[]
  area      Area        @relation(fields: [areaId], references: [id])
  members   NGOMember[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  members     NGOMember[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model NGOMember {
  id        String           @id @default(cuid())
  ngoId     String?
  roleId    String
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  ngo       NGO?             @relation(fields: [ngoId], references: [id])
  role      Role             @relation(fields: [roleId], references: [id])
}

model ActionLog {
  id        String   @id @default(cuid())
  ngoId     String
  action    String
  details   String?
  createdAt DateTime @default(now())
  ngo       NGO      @relation(fields: [ngoId], references: [id])
}

enum UserRole {
  CITIZEN
  ADMIN
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  LEGENDARY
}

enum PostStatus {
  PENDING
  PUBLISHED
  HIDDEN
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PaymentIntentStatus {
  CREATED
  SUCCESS
  FAILED
}

enum TaskType {
  INDIVIDUAL
  COMMUNITY
}

enum TaskCompletionStatus {
  STARTED
  SUBMITTED
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
  REWARD_PROCESSING
  COMPLETED
  COOLDOWN
}

enum TaskStatus {
  REGISTERED
  SUBMITTED
  UNDER_VERIFICATION
  COMPLETED
  REJECTED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskCategory {
  SUSTAINABILITY
  EDUCATION
  COMMUNITY
}

enum TaskVerificationType {
  IMAGE
  TEXT
  MCQ
  HYBRID
}

enum SubmissionStatus {
  STARTED
  SUBMITTED
  APPROVED
  REJECTED
  COOLDOWN
}

enum TransactionType {
  REWARD_EARNED
  REDEMPTION
  ADMIN_ADJUSTMENT
}

enum NGOStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
