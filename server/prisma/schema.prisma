generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String?
  role          UserRole            @default(CITIZEN)
  emailVerified Boolean             @default(false)
  createdAt     DateTime            @default(now())
  otps          Otp[]
  posts         Post[]
  profile       Profile?
  badges        UserBadge[]
  stats         UserStats?
  tokens        VerificationToken[]

  communityTaskRegistrations CommunityTaskRegistration[]
  taskScore      TaskScore[]
  taskSubmission TaskSubmission[]

  ledgerEntries    RewardLedger[]
  redemptions      Redemption[] 
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  username    String    @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  gender      String?
  country     String
  state       String
  city        String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id                 String    @id @default(cuid())
  userId             String    @unique
  totalContributions Int       @default(0)
  lastActivityAt     DateTime?
  xp                 Int       @default(0)
  level              Int       @default(1)
  actionsLast7Days   Int       @default(0)
  actionsLast30Days  Int       @default(0)
  engagementLevel    Float     @default(0.0)
  updatedAt          DateTime  @updatedAt
  currentStreak      Int       @default(0)
  globalRank         Int?
  longestStreak      Int       @default(0)
  nextMilestone      Float     @default(10.0)
  region             String?
  regionalRank       Int?
  rewardPoints       Int       @default(0)
  totalWeightRemoved Float     @default(0.0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  imageUrl    String
  rarity      BadgeRarity @default(COMMON)
  criteria    String
  createdAt   DateTime    @default(now())
  earnedBy    UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Post {
  id        String     @id @default(cuid())
  authorId  String
  content   String
  status    PostStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
}

model VerificationToken {
  id        String           @id @default(cuid())
  userId    String
  type      VerificationType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Otp {
  id            String           @id @default(cuid())
  userId        String
  code          String
  type          VerificationType
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  attempts      Int              @default(0)
  lastAttemptAt DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model payment_intents {
  id          String               @id @default(uuid())
  orderId     String               @unique
  userId      String
  campaignId  String
  amount      Int                  // stored in paise
  currency    String               @default("INR")
  status      PaymentIntentStatus  @default(CREATED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([campaignId])
  @@index([userId])
}

model external_donations {
  id          String    @id @default(uuid())
  paymentId   String    @unique   // Razorpay payment_id (idempotency)
  orderId     String
  campaignId  String
  amount      Int       // paise
  currency    String    @default("INR")
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([campaignId])
}

//for now the total amount collected will be derived on spot, when the performance becomes an issue then we can create a derived table
model campaigns {
  id          String    @id @default(uuid())
  title       String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}


enum UserRole {
  CITIZEN
  ADMIN
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  LEGENDARY
}

enum PostStatus {
  PENDING
  PUBLISHED
  HIDDEN
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PaymentIntentStatus {
  CREATED
  SUCCESS
  FAILED
}

enum TaskType {
  INDIVIDUAL
  COMMUNITY
}

//User need not to be realted to task, when a user would select a class it would be update in either CommunityTaskRegistration or 
//TaskSubmission and TaskScore so any detail for the user can be derived from TaskScore

// Task (later on)
//  ├── createdById
//  ├── createdByRole (ADMIN | NGO)

model Task {
  id          String   @id @default(cuid())
  type        TaskType

  title       String
  description String   @db.Text

  baseScore   Int
  isActive    Boolean  @default(true)

  startAt     DateTime?
  endAt       DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  individualTask IndividualTask?
  communityTask  CommunityTask?

  taskScores  TaskScore[]
}

model IndividualTask {
  id               String   @id @default(cuid())
  taskId           String   @unique

  difficulty       Difficulty           @default(EASY)
  category         TaskCategory         @default(SUSTAINABILITY)

  verificationType TaskVerificationType
  requirements     Json?

  educationalLink  String?
  factContent      String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  submissions TaskSubmission[]
}

model CommunityTask {
  id              String   @id @default(cuid())
  taskId          String   @unique

  maxParticipants Int?
  minParticipants Int?

  locationName    String?
  city            String?
  state           String?
  country         String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  registrations CommunityTaskRegistration[]
}


// CommunityTaskRegistration
//    ├── userId
//    ├── taskId
//    ├── attendance / completionConfirmed


// NGO Admin
//    ↓ marks completion
// CommunityTaskRegistration.completionConfirmed = true
//    ↓ triggers
// Task Service
//    ↓ updates
// TaskScore.status = VERIFIED

model CommunityTaskRegistration {
  id      String   @id @default(cuid())
  taskId  String
  userId  String

  task CommunityTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status TaskStatus @default(REGISTERED)

  completionConfirmed Boolean @default(false)
  supervisorNote      String? @db.Text
  reviewedAt          DateTime?

  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([status])
}

model TaskScore {
  id        String @id @default(cuid())
  userId    String
  taskId    String
  //Status lives where truth is decided
  status    TaskCompletionStatus @default(STARTED)

  baseScore        Int
  performanceScore Int @default(0)
  totalScore       Int

  verificationSource String?   // AI | NGO | SYSTEM
  verifiedAt        DateTime?
  rewardedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  rewardLedger RewardLedger?

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@index([status])
}


model TaskSubmission {
  id        String   @id @default(cuid())
  userId    String
  taskId    String

  status    SubmissionStatus @default(STARTED)

  evidenceUrls    String[]
  textResponse    String?
  mcqAnswer       String?

  submittedAt     DateTime @default(now())
  verifiedAt      DateTime?
  rejectionReason String?

  user User @relation(fields: [userId], references: [id])
  task IndividualTask @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
}

enum TaskCompletionStatus {
  STARTED              // user opted in / registered
  SUBMITTED            // evidence submitted or attendance marked
  UNDER_VERIFICATION   // AI or NGO reviewing
  VERIFIED             // verification passed
  REJECTED             // verification failed
  REWARD_PROCESSING    // sent to reward service
  COMPLETED            // reward credited (final)
}


enum TaskStatus {
  REGISTERED        
  SUBMITTED         
  UNDER_VERIFICATION
  COMPLETED
  REJECTED
}


enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskCategory {
  SUSTAINABILITY
  EDUCATION
  COMMUNITY
}

enum TaskVerificationType {
  IMAGE
  TEXT
  MCQ
  HYBRID 
}

enum SubmissionStatus {
  STARTED    
  SUBMITTED  
  APPROVED   
  REJECTED   
}
enum TransactionType {
  REWARD_EARNED
  REDEMPTION
  ADMIN_ADJUSTMENT // For fixing errors
}

model RewardLedger {
  id            String   @id @default(cuid())
  userId        String
  taskScoreId   String?  @unique   // idempotency anchor

  amount        Decimal  @db.Decimal(10, 2)
  type          TransactionType
  reason        String?

  user          User      @relation(fields: [userId], references: [id])
  taskScore     TaskScore? @relation(fields: [taskScoreId], references: [id])

  createdAt     DateTime @default(now())
}


model Redemption {
  id              String          @id @default(cuid())
  userId          String
  amount          Decimal         @db.Decimal(10, 2)
  status          String          @default("PENDING") // PENDING, APPROVED, REJECTED
  user            User            @relation(fields: [userId], references: [id])
  createdAt       DateTime        @default(now())
}