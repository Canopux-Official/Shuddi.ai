generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String?
  role          UserRole            @default(CITIZEN)
  emailVerified Boolean             @default(false)
  createdAt     DateTime            @default(now())
  otps          Otp[]
  posts         Post[]
  profile       Profile?
  badges        UserBadge[]
  stats         UserStats?
  tokens        VerificationToken[]
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  username    String    @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  gender      String?
  country     String
  state       String
  city        String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id                 String    @id @default(cuid())
  userId             String    @unique
  totalContributions Int       @default(0)
  lastActivityAt     DateTime?
  xp                 Int       @default(0)
  level              Int       @default(1)
  actionsLast7Days   Int       @default(0)
  actionsLast30Days  Int       @default(0)
  engagementLevel    Float     @default(0.0)
  updatedAt          DateTime  @updatedAt
  currentStreak      Int       @default(0)
  globalRank         Int?
  longestStreak      Int       @default(0)
  nextMilestone      Float     @default(10.0)
  region             String?
  regionalRank       Int?
  rewardPoints       Int       @default(0)
  totalWeightRemoved Float     @default(0.0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  imageUrl    String
  rarity      BadgeRarity @default(COMMON)
  criteria    String
  createdAt   DateTime    @default(now())
  earnedBy    UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Post {
  id        String     @id @default(cuid())
  authorId  String
  content   String
  status    PostStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
}

model VerificationToken {
  id        String           @id @default(cuid())
  userId    String
  type      VerificationType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Otp {
  id            String           @id @default(cuid())
  userId        String
  code          String
  type          VerificationType
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  attempts      Int              @default(0)
  lastAttemptAt DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model payment_intents {
  id          String               @id @default(uuid())
  orderId     String               @unique
  userId      String
  campaignId  String
  amount      Int                  // stored in paise
  currency    String               @default("INR")
  status      PaymentIntentStatus  @default(CREATED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([campaignId])
  @@index([userId])
}

model external_donations {
  id          String    @id @default(uuid())
  paymentId   String    @unique   // Razorpay payment_id (idempotency)
  orderId     String
  campaignId  String
  amount      Int       // paise
  currency    String    @default("INR")
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([campaignId])
}

//for now the total amount collected will be derived on spot, when the performance becomes an issue then we can create a derived table
model campaigns {
  id          String    @id @default(uuid())
  title       String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}


enum UserRole {
  CITIZEN
  ADMIN
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  LEGENDARY
}

enum PostStatus {
  PENDING
  PUBLISHED
  HIDDEN
  DELETED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PaymentIntentStatus {
  CREATED
  SUCCESS
  FAILED
}
